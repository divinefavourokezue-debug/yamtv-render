{
  "entities": {
    "articles": {
      "title": "Articles",
      "description": "News articles and editorial content for YAM TV",
      "properties": {
        "title_fr": { "type": "string", "description": "French title" },
        "title_en": { "type": "string", "description": "English title" },
        "content_fr": { "type": "string", "description": "French HTML content" },
        "content_en": { "type": "string", "description": "English HTML content" },
        "excerpt_fr": { "type": "string", "description": "French excerpt" },
        "excerpt_en": { "type": "string", "description": "English excerpt" },
        "image_url": { "type": "string", "description": "Main cover image URL" },
        "category": { "type": "string", "description": "Article category" },
        "published": { "type": "boolean", "description": "Publication status" },
        "featured": { "type": "boolean", "description": "Featured on home slider" },
        "breaking_text": { "type": "string", "description": "Breaking news banner text" },
        "slug": { "type": "string", "description": "URL slug" },
        "created_at": { "type": "string", "description": "ISO timestamp" },
        "updated_at": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["title_fr", "title_en", "category"]
    },
    "comments": {
      "title": "Comments",
      "description": "User comments on articles",
      "properties": {
        "article_id": { "type": "string", "description": "Associated article ID" },
        "author": { "type": "string", "description": "Author name or email" },
        "content": { "type": "string", "description": "Comment text" },
        "created_at": { "type": "string", "description": "ISO timestamp" },
        "status": { "type": "string", "description": "Approval status (approved/pending)" }
      },
      "required": ["article_id", "content"]
    },
    "media": {
      "title": "Media Assets",
      "description": "Uploaded media files and images",
      "properties": {
        "name": { "type": "string", "description": "File name" },
        "url": { "type": "string", "description": "Image URL or Data URL" },
        "type": { "type": "string", "description": "MIME type" },
        "size": { "type": "number", "description": "File size in bytes" },
        "created_at": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["name", "url"]
    },
    "settings": {
      "title": "Site Settings",
      "description": "Global website configurations",
      "properties": {
        "site_name": { "type": "string", "description": "Website title" },
        "contact_email": { "type": "string", "description": "Contact email address" },
        "maintenance_mode": { "type": "boolean", "description": "Maintenance mode state" }
